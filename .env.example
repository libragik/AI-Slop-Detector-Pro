# Copy this file to .env.local and add your OWN keys there, never in this file.
# .env.local and all other .env* files except this template are ignored by Git.
# Never prefix API credentials with NEXT_PUBLIC_: that exposes them to browsers.
# Required for scans: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_VIDEO_PROCESSING=agentic
# Every scan also includes a full static sweep. These settings govern its
# sampling and the separate reviewer; changing them invalidates cached reports.
GEMINI_SWEEP_FPS=2
GEMINI_REVIEW_FPS=6
GEMINI_REVIEW_MODEL=gemini-3.7-flash

# Optional: enable YouTube Data API v3 in your own Google Cloud project.
# Adds YouTube title, disclosure, and comment evidence.
YOUTUBE_API_KEY=
YOUTUBE_COMMENT_LIMIT=100

# Optional: persistent result cache in your own Supabase project.
# Apply BOTH SQL files in supabase/migrations/ in filename order first.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
CACHE_ENABLED=true
CACHE_TTL_HOURS=720

# Public app URL, used for metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Safety and cost controls.
MAX_MEDIA_BYTES=500000000
ANALYSIS_CONCURRENCY=2
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_FRESH=5
YT_DLP_TIMEOUT_MS=45000
GEMINI_FILE_TIMEOUT_MS=45000
GEMINI_HTTP_TIMEOUT_MS=60000
GEMINI_RETRY_MAX=2
MAX_DURATION_SECONDS=180
ANALYSIS_MAX_QUEUE=0

# Runtime paths and version labels.
YT_DLP_PATH=yt-dlp
FFPROBE_PATH=ffprobe
C2PA_ENABLED=true
ANALYZER_VERSION=evidence-2

# Optional specialist visual evidence (server only; never NEXT_PUBLIC).
# Repeated Sightengine visual findings determine the AI verdict; Gemini adds context.
# Scores are not calibrated probabilities.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
SIGHTENGINE_ENABLED=true
